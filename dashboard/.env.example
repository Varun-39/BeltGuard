# Copy to .env. Optional -- unset, the landing page skips sign-in entirely
# and opens straight to the workstation, same as before this existed.

# Google sign-in (src/auth.ts), client-side only via Google Identity Services.
# This is a Client ID, not a secret -- it is meant to be public and ships in
# the browser bundle regardless of where you put it.
#
# To get one:
#   1. https://console.cloud.google.com/apis/credentials -- pick or create a project
#   2. "Configure consent screen" if this project hasn't got one yet (External,
#      fill in an app name and your email; test users can be just yourself)
#   3. "Create credentials" -> "OAuth client ID" -> Application type "Web application"
#   4. Under "Authorized JavaScript origins" add every origin you'll open this
#      from: http://localhost:3000, and http://<your-LAN-IP>:3000 for the
#      "Open on phone" QR code to work too (see vite.config.ts, /__lan-ip)
#   5. Copy the Client ID it gives you (ends in .apps.googleusercontent.com)
VITE_GOOGLE_CLIENT_ID=

# Backend base URL (src/config.ts). Leave unset for local dev (vite.config.ts
# proxies /api, /ws, /stream to localhost:8010) and for any deploy where the
# frontend and backend share an origin. Set this only when they're deployed
# as separate Render services (see render.yaml):
#   VITE_API_BASE=https://beltguard-backend.onrender.com
VITE_API_BASE=
