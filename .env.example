# Copy to .env and fill in what you need. Every value is optional -- the system
# runs without any of them, it just does less.

# Vision dataset download (vision/scripts/prepare_dataset.py).
# Free key from https://app.roboflow.com/settings/api
ROBOFLOW_API_KEY=

# Where heavy vision artifacts live. Defaults to %LOCALAPPDATA%/sih26 on Windows
# and ~/.local/share/sih26 elsewhere. Set this to move them to another disk.
# They are kept OUT of the project folder because this repo sits under OneDrive,
# which syncs by folder tree and does not read .gitignore.
SIH_DATA_DIR=

# Alert escalation (backend/notify.py). With SMTP_HOST or ALERT_TO unset, alerts
# are logged with delivered=false instead of mailed -- a supported mode, not an
# error. /api/alerts reports which mode is active.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_FROM=
ALERT_TO=
